{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "body-xunji-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "secrets": {
    "required": [
      "XUNJI_API_KEY",
      "XUNJI_TRAIN_API_KEY",
      "XUNJI_FOOD_API_KEY",
      "XUNJI_FOOD_SEARCH_KEY",
      "XUNJI_BODY_API_KEY",
      "XUNJI_TEMPLATE_API_KEY",
      "BODY_QUEUE_SECRET"
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
